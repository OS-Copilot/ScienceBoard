# ScienceBoard runner
SCI_MODEL=gpt_4o
SCI_MODE=raw
SCI_TASKS_PATH=./tasks/Raw
SCI_LOGS_PATH=./logs/gpt_4o-raw
SCI_HEADLESS=true
SCI_IGNORE=true

# Optional HTTP(S) proxy used by model requests.
HTTPX_PROXY=

# Commercial model credentials (only the selected model is required).
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01

# Optional local key bank. Selecting SCI_MODEL=key_bank loads the secret only
# at runtime instead of copying it into this file.
KEY_BANK_PATH=
KEY_BANK_ENTRY=
KEY_BANK_MODEL=

# VMware mode. VM_PATH may point to VM.zip or an extracted .vmx file.
VM_PATH=

# Docker mode. The default CPU renderer works without KVM or a GPU.
DOCKER_IMAGE=scienceboard:0.1
DOCKER_BINARY=docker
DOCKER_STARTUP_TIMEOUT=240
# Optional extra arguments inserted before the image in `docker run`.
DOCKER_RUN_ARGS=

# OpenAI-compatible local/hosted models.
QWEN_VL_URL=
QWEN_VL_NAME=
INTERN_VL_URL=
INTERN_VL_NAME=
QVQ_VL_URL=
QVQ_VL_NAME=
OS_ACT_URL=
OS_ACT_NAME=
GUI_ACTOR_URL=
GUI_ACTOR_NAME=
UGROUND_URL=
UGROUND_NAME=
TARS_DPO_URL=
TARS_DPO_NAME=

# Raw-mode scientific applications. The bundled Raw task set currently uses Lean.
LEAN_LIB_PATH=./runtime/lean-repl
QT6_LIB_PATH=
FFI_LIB_PATH=
KALG_BIN_PATH=
CELE_BIN_PATH=
GIS_BIN_PATH=
